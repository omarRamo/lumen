{
  "appId": "com.omartrabelsi.lumen",
  "appName": "LUMEN",
  "webDir": "dist",
  "ios": {
    "scheme": "LUMEN",
    "contentInset": "never",
    "scrollEnabled": false,
    "limitsNavigationsToAppBoundDomains": true,
    "backgroundColor": "#dce6d5"
  },
  "android": {
    "backgroundColor": "#dce6d5",
    "zoomEnabled": false,
    "allowMixedContent": false,
    "captureInput": false,
    "useLegacyBridge": false,
    "minWebViewVersion": 90,
    "loggingBehavior": "production"
  },
  "server": { "iosScheme": "capacitor", "androidScheme": "https" }
}
